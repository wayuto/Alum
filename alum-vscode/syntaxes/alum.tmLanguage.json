{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Alum",
    "scopeName": "source.alum",
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#preprocessor"
        },
        {
            "include": "#struct-declaration"
        },
        {
            "include": "#union-declaration"
        },
        {
            "include": "#enum-declaration"
        },
        {
            "include": "#function-declaration"
        },
        {
            "include": "#extern-declaration"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#match-expression"
        },
        {
            "include": "#typedef"
        },
        {
            "include": "#struct-literal"
        },
        {
            "include": "#types"
        },
        {
            "include": "#lambda"
        },
        {
            "include": "#variable-declaration"
        },
        {
            "include": "#for-loop"
        },
        {
            "include": "#builtin-functions"
        },
        {
            "include": "#function-call"
        },
        {
            "include": "#literals"
        },
        {
            "include": "#operators"
        }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.alum",
                    "match": "//.*$"
                }
            ]
        },
        "preprocessor": {
            "patterns": [
                {
                    "name": "keyword.control.preprocessor.alum",
                    "match": "\\$(import|define|ifdef|ifndef|endif)\\b"
                },
                {
                    "name": "meta.preprocessor.import.alum",
                    "begin": "(\\$import)\\s+(\")",
                    "end": "(\")",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.control.preprocessor.alum"
                        },
                        "2": {
                            "name": "punctuation.definition.string.begin.alum"
                        }
                    },
                    "endCaptures": {
                        "1": {
                            "name": "punctuation.definition.string.end.alum"
                        }
                    },
                    "contentName": "string.quoted.double.alum"
                },
                {
                    "name": "meta.preprocessor.define.simple.alum",
                    "begin": "(\\$define)\\s+(\\w+)(\\s+)",
                    "end": "(?=\\n|$)",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.control.preprocessor.alum"
                        },
                        "2": {
                            "name": "entity.name.constant.macro.alum"
                        },
                        "3": {
                            "name": "text"
                        }
                    },
                    "patterns": [
                        {
                            "include": "$self"
                        }
                    ]
                },
                {
                    "name": "meta.preprocessor.define.macro.alum",
                    "begin": "(\\$define)\\s+(\\w+)\\s*(\\()",
                    "end": "(\\))",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.control.preprocessor.alum"
                        },
                        "2": {
                            "name": "entity.name.function.macro.alum"
                        },
                        "3": {
                            "name": "punctuation.definition.parameters.begin.alum"
                        }
                    },
                    "endCaptures": {
                        "1": {
                            "name": "punctuation.definition.parameters.end.alum"
                        }
                    }
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.alum",
                    "match": "\\b(if|else|while|for|in|break|continue|match)\\b"
                },
                {
                    "name": "keyword.control.return.alum",
                    "match": "\\breturn\\b"
                },
                {
                    "name": "storage.modifier.alum",
                    "match": "\\blet\\b"
                },
                {
                    "name": "keyword.declaration.function.alum",
                    "match": "\\bfun\\b"
                },
                {
                    "name": "keyword.declaration.extern.alum",
                    "match": "\\bextern\\b"
                },
                {
                    "name": "keyword.declaration.struct.alum",
                    "match": "\\bstruct\\b"
                },
  {
   "name": "keyword.declaration.union.alum",
   "match": "\\bunion\\b"
  },
  {
   "name": "keyword.declaration.enum.alum",
   "match": "\\benum\\b"
  },
                {
                    "name": "keyword.declaration.typedef.alum",
                    "match": "\\btypedef\\b"
                },
                {
                    "name": "keyword.declaration.lambda.alum",
                    "match": "\\\\\\("
                },
                {
                    "name": "constant.language.boolean.alum",
                    "match": "\\b(true|false)\\b"
                },
                {
                    "name": "constant.language.null.alum",
                    "match": "\\bnil\\b"
                }
            ]
        },
        "match-expression": {
            "patterns": [
                {
                    "name": "meta.match.alum",
                    "begin": "(\\bmatch)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(\\{)",
                    "end": "(\\})",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.control.alum"
                        },
                        "2": {
                            "name": "variable.other.readwrite.alum"
                        },
                        "3": {
                            "name": "punctuation.definition.block.begin.alum"
                        }
                    },
                    "endCaptures": {
                        "1": {
                            "name": "punctuation.definition.block.end.alum"
                        }
                    },
                    "patterns": [
                        {
                            "name": "keyword.control.match.wildcard.alum",
                            "match": "_\\s*(?=:)"
                        },
                        {
                            "name": "constant.numeric.match-case.alum",
                            "match": "\\b[0-9]+\\b\\s*(?=:)"
                        },
                        {
                            "name": "punctuation.separator.match-case.alum",
                            "match": ":"
                        },
                        {
                            "include": "$self"
                        }
                    ]
                }
            ]
        },
        "typedef": {
            "patterns": [
                {
                    "name": "meta.typedef.alum",
                    "begin": "(\\btypedef)\\s+(\\w+)\\s*(=)",
                    "end": "(?=[\\n;\\}])",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.declaration.typedef.alum"
                        },
                        "2": {
                            "name": "entity.name.type.typedef.alum"
                        },
                        "3": {
                            "name": "keyword.operator.assignment.alum"
                        }
                    },
                    "patterns": [
                        {
                            "include": "$self"
                        }
                    ]
                }
            ]
        },
        "struct-declaration": {
            "patterns": [
                {
                    "name": "meta.struct.declaration.alum",
                    "begin": "(\\bstruct)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(?:<[^\\n{]*>)?\\s*(\\{)",
                    "end": "(\\})",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.declaration.struct.alum"
                        },
                        "2": {
                            "name": "entity.name.type.struct.alum"
                        },
                        "3": {
                            "name": "punctuation.definition.block.begin.alum"
                        }
                    },
                    "endCaptures": {
                        "1": {
                            "name": "punctuation.definition.block.end.alum"
                        }
                    },
                    "patterns": [
                        {
                            "include": "#comments"
                        },
                        {
                            "name": "variable.other.member.alum",
                            "match": "([A-Za-z_][A-Za-z0-9_]*)\\s*(:)",
                            "captures": {
                                "1": {
                                    "name": "variable.other.member.alum"
                                },
                                "2": {
                                    "name": "punctuation.separator.type-annotation.alum"
                                }
                            }
                        },
                        {
                            "include": "$self"
                        }
                    ]
                }
            ]
        },
        "struct-literal": {
            "patterns": [
                {
                    "name": "meta.struct.literal.generic.alum",
                    "begin": "([A-Z][A-Za-z0-9_]*)(<[^\\n{}]*>)\\s*(\\{)",
                    "end": "(\\})",
                    "beginCaptures": {
                        "1": {
                            "name": "entity.name.type.struct.alum"
                        },
                        "2": {
                            "name": "meta.type.generic.alum"
                        },
                        "3": {
                            "name": "punctuation.definition.block.begin.alum"
                        }
                    },
                    "endCaptures": {
                        "1": {
                            "name": "punctuation.definition.block.end.alum"
                        }
                    },
                    "patterns": [
                        {
                            "name": "variable.other.member.alum",
                            "match": "([A-Za-z_][A-Za-z0-9_]*)\\s*(:)",
                            "captures": {
                                "1": {
                                    "name": "variable.other.member.alum"
                                },
                                "2": {
                                    "name": "punctuation.separator.key-value.alum"
                                }
                            }
                        },
                        {
                            "include": "$self"
                        }
                    ]
                },
                {
                    "name": "meta.struct.literal.alum",
                    "begin": "(?<![A-Za-z0-9_.])(?!\\b(int|float|string|bool|void|gen)\\b)([A-Za-z_][A-Za-z0-9_]*)\\s*(\\{)",
                    "end": "(\\})",
                    "beginCaptures": {
                        "1": {
                            "name": "entity.name.type.struct.alum"
                        },
                        "2": {
                            "name": "punctuation.definition.block.begin.alum"
                        }
                    },
                    "endCaptures": {
                        "1": {
                            "name": "punctuation.definition.block.end.alum"
                        }
                    },
                    "patterns": [
                        {
                            "name": "variable.other.member.alum",
                            "match": "([A-Za-z_][A-Za-z0-9_]*)\\s*(:)",
                            "captures": {
                                "1": {
                                    "name": "variable.other.member.alum"
                                },
                                "2": {
                                    "name": "punctuation.separator.key-value.alum"
                                }
                            }
                        },
                        {
                            "include": "$self"
                        }
                    ]
                }
            ]
        },
        "union-declaration": {
            "patterns": [
                {
                    "name": "meta.union.declaration.alum",
                    "begin": "(\\bunion)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(?:<[^\\n{]*>)?\\s*(\\{)",
                    "end": "(\\})",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.declaration.union.alum"
                        },
                        "2": {
                            "name": "entity.name.type.union.alum"
                        },
                        "3": {
                            "name": "punctuation.definition.block.begin.alum"
                        }
                    },
                    "endCaptures": {
                        "1": {
                            "name": "punctuation.definition.block.end.alum"
                        }
                    },
                    "patterns": [
                        {
                            "include": "#comments"
                        },
                        {
                            "name": "variable.other.member.alum",
                            "match": "([A-Za-z_][A-Za-z0-9_]*)\\s*(:)",
                            "captures": {
                                "1": {
                                    "name": "variable.other.member.alum"
                                },
                                "2": {
                                    "name": "punctuation.separator.type-annotation.alum"
                                }
                            }
                        },
                        {
                            "include": "$self"
                        }
                    ]
                }
            ]
        },
        "enum-declaration": {
            "patterns": [
                {
                    "name": "meta.enum.declaration.alum",
                    "begin": "(\\benum)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(\\{)",
                    "end": "(\\})",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.declaration.enum.alum"
                        },
                        "2": {
                            "name": "entity.name.type.enum.alum"
                        },
                        "3": {
                            "name": "punctuation.definition.block.begin.alum"
                        }
                    },
                    "endCaptures": {
                        "1": {
                            "name": "punctuation.definition.block.end.alum"
                        }
                    },
                    "patterns": [
                        {
                            "include": "#comments"
                        },
                        {
                            "name": "constant.other.enum.alum",
                            "match": "([A-Za-z_][A-Za-z0-9_]*)\\s*(=)",
                            "captures": {
                                "1": {
                                    "name": "constant.other.enum.alum"
                                },
                                "2": {
                                    "name": "keyword.operator.assignment.alum"
                                }
                            }
                        },
                        {
                            "name": "constant.other.enum.alum",
                            "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b(?=\\s*(,|}))"
                        },
                        {
                            "include": "$self"
                        }
                    ]
                }
            ]
        },
        "types": {
            "patterns": [
                {
                    "name": "storage.type.primitive.alum",
                    "match": "\\b(int|float|string|bool|void|gen)\\b"
                },
                {
                    "name": "storage.type.pointer.alum",
                    "match": "\\*[a-zA-Z_][A-Za-z0-9_]*"
                },
                {
                    "name": "storage.type.vec.alum",
                    "match": "\\bVec\\b"
                },
                {
                    "name": "meta.type.generic.alum",
                    "begin": "\\b[A-Z][A-Za-z0-9_]*\\b(?=<)",
                    "end": "(?<=>)",
                    "patterns": [
                        {
                            "name": "punctuation.definition.generic.begin.alum",
                            "match": "<"
                        },
                        {
                            "name": "punctuation.definition.generic.end.alum",
                            "match": ">"
                        },
                        {
                            "name": "entity.name.type.parameter.alum",
                            "match": "[A-Za-z_][A-Za-z0-9_]*"
                        }
                    ]
                },
                {
                    "name": "meta.type.array.alum",
                    "begin": "(\\barr)\\s*(\\[)",
                    "end": "(\\])",
                    "beginCaptures": {
                        "1": {
                            "name": "storage.type.array.alum"
                        },
                        "2": {
                            "name": "punctuation.definition.array.begin.alum"
                        }
                    },
                    "endCaptures": {
                        "1": {
                            "name": "punctuation.definition.array.end.alum"
                        }
                    },
                    "patterns": [
                        {
                            "name": "storage.type.primitive.alum",
                            "match": "[A-Za-z_][A-Za-z0-9_]*"
                        }
                    ]
                },
                {
                    "name": "storage.type.alum",
                    "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
                }
            ]
        },
        "lambda": {
            "patterns": [
                {
                    "name": "meta.lambda.alum",
                    "begin": "(\\\\\\()",
                    "end": "(\\))\\s*(:)\\s*([\\w\\[\\]]+)",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.declaration.lambda.alum"
                        }
                    },
                    "endCaptures": {
                        "1": {
                            "name": "punctuation.definition.parameters.end.alum"
                        },
                        "2": {
                            "name": "punctuation.separator.type-annotation.alum"
                        },
                        "3": {
                            "patterns": [
                                {
                                    "include": "#types"
                                }
                            ]
                        }
                    },
                    "patterns": [
                        {
                            "name": "variable.parameter.alum",
                            "match": "([A-Za-z_][A-Za-z0-9_]*)\\s*(:)",
                            "captures": {
                                "1": {
                                    "name": "variable.parameter.alum"
                                },
                                "2": {
                                    "name": "punctuation.separator.type-annotation.alum"
                                }
                            }
                        },
                        {
                            "include": "#types"
                        },
                        {
                            "name": "punctuation.separator.alum",
                            "match": ","
                        }
                    ]
                }
            ]
        },
        "function-declaration": {
            "patterns": [
                {
                    "name": "meta.function.declaration.alum",
                    "begin": "(\\bfun)\\s*(\\((?![^)]*\\bextern\\b)[^)]*\\))?\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*(<[^>]*>)?\\s*(\\()",
                    "end": "(\\))\\s*(:)\\s*([\\w\\[\\]<>*]+)\\s*(\\{)",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.declaration.function.alum"
                        },
                        "2": {
                            "name": "meta.function.annotations.alum",
                            "patterns": [
                                {
                                    "name": "keyword.declaration.extern.alum",
                                    "match": "\\bextern\\b"
                                },
                                {
                                    "name": "storage.modifier.function-annotation.alum",
                                    "match": "\\b(pub|pure)\\b"
                                }
                            ]
                        },
                        "3": {
                            "name": "entity.name.function.alum"
                        },
                        "4": {
                            "patterns": [
                                {
                                    "name": "punctuation.definition.generic.begin.alum",
                                    "match": "<"
                                },
                                {
                                    "name": "punctuation.definition.generic.end.alum",
                                    "match": ">"
                                },
                                {
                                    "name": "entity.name.type.parameter.alum",
                                    "match": "[A-Za-z_][A-Za-z0-9_]*"
                                }
                            ]
                        },
                        "5": {
                            "name": "punctuation.definition.parameters.begin.alum"
                        }
                    },
                    "endCaptures": {
                        "1": {
                            "name": "punctuation.definition.parameters.end.alum"
                        },
                        "2": {
                            "name": "punctuation.separator.type-annotation.alum"
                        },
                        "3": {
                            "patterns": [
                                {
                                    "include": "#types"
                                }
                            ]
                        },
                        "4": {
                            "name": "punctuation.definition.block.begin.alum"
                        }
                    },
                    "patterns": [
                        {
                            "name": "variable.parameter.alum",
                            "match": "([A-Za-z_][A-Za-z0-9_]*)\\s*(:)\\s*([\\w\\[\\]]+)",
                            "captures": {
                                "1": {
                                    "name": "variable.parameter.alum"
                                },
                                "2": {
                                    "name": "punctuation.separator.type-annotation.alum"
                                },
                                "3": {
                                    "patterns": [
                                        {
                                            "include": "#types"
                                        }
                                    ]
                                }
                            }
                        },
                        {
                            "include": "#types"
                        },
                        {
                            "name": "punctuation.separator.alum",
                            "match": ","
                        }
                    ]
                }
            ]
        },
        "extern-declaration": {
            "patterns": [
                {
                    "name": "meta.extern.function.declaration.alum",
                    "begin": "(\\bfun)\\s*(\\([^)]*\\bextern\\b[^)]*\\))\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*(<[^>]*>)?\\s*(\\()",
                    "end": "(\\))\\s*(:)\\s*([\\w\\[\\]<>*]+)",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.declaration.function.alum"
                        },
                        "2": {
                            "name": "meta.function.annotations.alum",
                            "patterns": [
                                {
                                    "name": "keyword.declaration.extern.alum",
                                    "match": "\\bextern\\b"
                                },
                                {
                                    "name": "storage.modifier.function-annotation.alum",
                                    "match": "\\b(pub|pure)\\b"
                                }
                            ]
                        },
                        "3": {
                            "name": "entity.name.function.extern.alum"
                        },
                        "4": {
                            "patterns": [
                                {
                                    "name": "punctuation.definition.generic.begin.alum",
                                    "match": "<"
                                },
                                {
                                    "name": "punctuation.definition.generic.end.alum",
                                    "match": ">"
                                },
                                {
                                    "name": "entity.name.type.parameter.alum",
                                    "match": "[A-Za-z_][A-Za-z0-9_]*"
                                }
                            ]
                        },
                        "5": {
                            "name": "punctuation.definition.parameters.begin.alum"
                        }
                    },
                    "endCaptures": {
                        "1": {
                            "name": "punctuation.definition.parameters.end.alum"
                        },
                        "2": {
                            "name": "punctuation.separator.type-annotation.alum"
                        },
                        "3": {
                            "patterns": [
                                {
                                    "include": "#types"
                                }
                            ]
                        }
                    },
                    "patterns": [
                        {
                            "name": "variable.parameter.alum",
                            "match": "([A-Za-z_][A-Za-z0-9_]*)\\s*(:)\\s*([\\w\\[\\]]+)",
                            "captures": {
                                "1": {
                                    "name": "variable.parameter.alum"
                                },
                                "2": {
                                    "name": "punctuation.separator.type-annotation.alum"
                                },
                                "3": {
                                    "patterns": [
                                        {
                                            "include": "#types"
                                        }
                                    ]
                                }
                            }
                        },
                        {
                            "include": "#types"
                        },
                        {
                            "name": "punctuation.separator.alum",
                            "match": ","
                        }
                    ]
                },
                {
                    "name": "meta.extern.variable.declaration.alum",
                    "match": "(\\bextern)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(:)\\s*([\\w\\[\\]<>*]+)",
                    "captures": {
                        "1": {
                            "name": "keyword.declaration.extern.alum"
                        },
                        "2": {
                            "name": "variable.other.extern.alum"
                        },
                        "3": {
                            "name": "punctuation.separator.type-annotation.alum"
                        },
                        "4": {
                            "patterns": [
                                {
                                    "include": "#types"
                                }
                            ]
                        }
                    }
                }
            ]
        },
        "variable-declaration": {
            "patterns": [
                {
                    "name": "meta.variable.declaration.alum",
                    "match": "(\\blet)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(:)\\s*([\\w\\[\\]<>*,*\\s]+\\s*)\\s*(=)",
                    "captures": {
                        "1": {
                            "name": "storage.modifier.alum"
                        },
                        "2": {
                            "name": "variable.other.readwrite.alum"
                        },
                        "3": {
                            "name": "punctuation.separator.type-annotation.alum"
                        },
                        "4": {
                            "patterns": [
                                {
                                    "include": "#types"
                                }
                            ]
                        },
                        "5": {
                            "name": "keyword.operator.assignment.alum"
                        }
                    }
                }
            ]
        },
        "builtin-functions": {
            "patterns": [
                {
                    "name": "support.function.builtin.io.alum",
                    "match": "\\b(write|read|print|println|input|fopen|fclose|fread|fwrite|lseek)\\b"
                },
                {
                    "name": "support.function.builtin.vec.alum",
                    "match": "\\b(vec_new)\\b"
                },
                {
                    "name": "support.function.builtin.math.alum",
                    "match": "\\b(abs|sqrt|max|min|pow|fact)\\b"
                },
                {
                    "name": "support.function.builtin.string.alum",
                    "match": "\\b(strlen|strcpy|strcat|strcmp|memcpy|memset|bcmp|memcmp)\\b"
                },
                {
                    "name": "support.function.builtin.convert.alum",
                    "match": "\\b(itoa|atoi|atof|ftoa)\\b"
                },
                {
                    "name": "support.function.builtin.memory.alum",
