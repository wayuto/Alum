{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Alum",
    "scopeName": "source.alum",
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#preprocessor"
        },
        {
            "include": "#variable-declaration"
        },
        {
            "include": "#typedef"
        },
        {
            "include": "#function-declaration"
        },
        {
            "include": "#extern-function-declaration"
        },
        {
            "include": "#struct-declaration"
        },
        {
            "include": "#union-declaration"
        },
        {
            "include": "#enum-declaration"
        },
        {
            "include": "#match-expression"
        },
        {
            "include": "#struct-literal"
        },
        {
            "include": "#lambda"
        },
        {
            "include": "#global-declaration"
        },
        {
            "include": "#for-loop"
        },
        {
            "include": "#builtin-functions"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#function-call"
        },
        {
            "include": "#literals"
        },
        {
            "include": "#operators"
        }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.alum",
                    "match": "//.*$"
                }
            ]
        },
        "preprocessor": {
            "patterns": [
                {
                    "name": "meta.preprocessor.import.alum",
                    "begin": "(\\$import)\\s+(\")",
                    "end": "(\")",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.control.preprocessor.alum"
                        },
                        "2": {
                            "name": "punctuation.definition.string.begin.alum"
                        }
                    },
                    "endCaptures": {
                        "1": {
                            "name": "punctuation.definition.string.end.alum"
                        }
                    },
                    "contentName": "string.quoted.double.alum"
                },
                {
                    "name": "meta.preprocessor.define.alum",
                    "begin": "(\\$define)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(\\()?",
                    "end": "(?=\\n|$)",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.control.preprocessor.alum"
                        },
                        "2": {
                            "name": "entity.name.constant.macro.alum"
                        },
                        "3": {
                            "name": "punctuation.definition.parameters.begin.alum"
                        }
                    },
                    "patterns": [
                        {
                            "include": "$self"
                        }
                    ]
                },
                {
                    "name": "keyword.control.preprocessor.alum",
                    "match": "\\$(ifdef|ifndef|endif)\\b"
                }
            ]
        },
        "global-declaration": {
            "patterns": [
                {
                    "name": "meta.global.variable.declaration.alum",
                    "match": "\\b(cst)(\\s*\\(\\s*(pub)\\s*\\))?\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(:)\\s*([A-Za-z_][A-Za-z0-9_]*(?:<[^>\\n]*>)?(?:\\[[0-9]*\\])?(?:\\s*\\([^)\\n]*\\))?)",
                    "captures": {
                        "1": {
                            "name": "storage.modifier.variable.alum"
                        },
                        "2": {
                            "patterns": [
                                {
                                    "name": "storage.modifier.pub.alum",
                                    "match": "pub"
                                }
                            ]
                        },
                        "4": {
                            "name": "variable.other.global.alum"
                        },
                        "5": {
                            "name": "punctuation.separator.type-annotation.alum"
                        },
                        "6": {
                            "patterns": [
                                {
                                    "include": "#types"
                                }
                            ]
                        }
                    }
                },
                {
                    "name": "meta.extern.variable.declaration.alum",
                    "match": "\\b(extern)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(:)\\s*([A-Za-z_][A-Za-z0-9_]*(?:<[^>\\n]*>)?(?:\\[[0-9]*\\])?(?:\\s*\\([^)\\n]*\\))?)",
                    "captures": {
                        "1": {
                            "name": "keyword.declaration.extern.alum"
                        },
                        "2": {
                            "name": "variable.other.extern.alum"
                        },
                        "3": {
                            "name": "punctuation.separator.type-annotation.alum"
                        },
                        "4": {
                            "patterns": [
                                {
                                    "include": "#types"
                                }
                            ]
                        }
                    }
                }
            ]
        },
        "typedef": {
            "patterns": [
                {
                    "name": "meta.typedef.alum",
                    "match": "\\b(typedef)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(=)\\s*([A-Za-z_][A-Za-z0-9_]*(?:<[^>\\n]*>)?(?:\\[[0-9]*\\])?(?:\\s*\\([^)\\n]*\\))?)",
                    "captures": {
                        "1": {
                            "name": "keyword.declaration.typedef.alum"
                        },
                        "2": {
                            "name": "entity.name.type.typedef.alum"
                        },
                        "3": {
                            "name": "keyword.operator.assignment.alum"
                        },
                        "4": {
                            "patterns": [
                                {
                                    "include": "#types"
                                }
                            ]
                        }
                    }
                }
            ]
        },
        "function-declaration": {
            "patterns": [
                {
                    "name": "meta.function.declaration.alum",
                    "begin": "\\b(fun)\\b\\s*(\\((?!\\s*[^)]*\\bextern\\b)[^)]*\\))?\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*(<[^>\\n]*>)?\\s*(\\()",
                    "end": "(\\{)",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.declaration.function.alum"
                        },
                        "2": {
                            "patterns": [
                                {
                                    "name": "storage.modifier.function-annotation.alum",
                                    "match": "\\b(pub|pure)\\b"
                                },
                                {
                                    "name": "keyword.declaration.extern.alum",
                                    "match": "\\bextern\\b"
                                },
                                {
                                    "name": "punctuation.definition.annotations.begin.alum",
                                    "match": "\\("
                                },
                                {
                                    "name": "punctuation.definition.annotations.end.alum",
                                    "match": "\\)"
                                }
                            ]
                        },
                        "3": {
                            "name": "entity.name.function.alum"
                        },
                        "4": {
                            "patterns": [
                                {
                                    "name": "punctuation.definition.generic.begin.alum",
                                    "match": "<"
                                },
                                {
                                    "name": "punctuation.definition.generic.end.alum",
                                    "match": ">"
                                },
                                {
                                    "name": "entity.name.type.parameter.alum",
                                    "match": "[A-Za-z_][A-Za-z0-9_]*"
                                }
                            ]
                        },
                        "5": {
                            "name": "punctuation.definition.parameters.begin.alum"
                        }
                    },
                    "endCaptures": {
                        "1": {
                            "name": "punctuation.definition.block.begin.alum"
                        }
                    },
                    "patterns": [
                        {
                            "name": "meta.parameter.alum",
                            "match": "([A-Za-z_][A-Za-z0-9_]*)\\s*(:)",
                            "captures": {
                                "1": {
                                    "name": "variable.parameter.alum"
                                },
                                "2": {
                                    "name": "punctuation.separator.type-annotation.alum"
                                }
                            }
                        },
                        {
                            "include": "#types"
                        },
                        {
                            "name": "punctuation.definition.parameters.end.alum",
                            "match": "\\)"
                        },
                        {
                            "name": "punctuation.separator.type-annotation.alum",
                            "match": ":"
                        },
                        {
                            "name": "punctuation.separator.alum",
                            "match": ","
                        },
                        {
                            "include": "#comments"
                        }
                    ]
                }
            ]
        },
        "extern-function-declaration": {
            "patterns": [
                {
                    "name": "meta.extern.function.declaration.alum",
                    "begin": "\\b(fun)\\b\\s*(\\([^)]*\\bextern\\b[^)]*\\))\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*(<[^>\\n]*>)?\\s*(\\()",
                    "end": "(\\))\\s*(:)\\s*([A-Za-z_][A-Za-z0-9_]*(?:<[^>\\n]*>)?(?:\\[[0-9]*\\])?(?:\\s*\\([^)\\n]*\\))?)",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.declaration.function.alum"
                        },
                        "2": {
                            "patterns": [
                                {
                                    "name": "keyword.declaration.extern.alum",
                                    "match": "\\bextern\\b"
                                },
                                {
                                    "name": "storage.modifier.function-annotation.alum",
                                    "match": "\\b(pub|pure)\\b"
                                },
                                {
                                    "name": "punctuation.definition.annotations.begin.alum",
                                    "match": "\\("
                                },
                                {
                                    "name": "punctuation.definition.annotations.end.alum",
                                    "match": "\\)"
                                }
                            ]
                        },
                        "3": {
                            "name": "entity.name.function.extern.alum"
                        },
                        "4": {
                            "patterns": [
                                {
                                    "name": "punctuation.definition.generic.begin.alum",
                                    "match": "<"
                                },
                                {
                                    "name": "punctuation.definition.generic.end.alum",
                                    "match": ">"
                                },
                                {
                                    "name": "entity.name.type.parameter.alum",
                                    "match": "[A-Za-z_][A-Za-z0-9_]*"
                                }
                            ]
                        },
                        "5": {
                            "name": "punctuation.definition.parameters.begin.alum"
                        }
                    },
                    "endCaptures": {
                        "1": {
                            "name": "punctuation.definition.parameters.end.alum"
                        },
                        "2": {
                            "name": "punctuation.separator.type-annotation.alum"
                        },
                        "3": {
                            "patterns": [
                                {
                                    "include": "#types"
                                }
                            ]
                        }
                    },
                    "patterns": [
                        {
                            "name": "meta.parameter.alum",
                            "match": "([A-Za-z_][A-Za-z0-9_]*)\\s*(:)",
                            "captures": {
                                "1": {
                                    "name": "variable.parameter.alum"
                                },
                                "2": {
                                    "name": "punctuation.separator.type-annotation.alum"
                                }
                            }
                        },
                        {
                            "include": "#types"
                        },
                        {
                            "name": "punctuation.separator.alum",
                            "match": ","
                        },
                        {
                            "include": "#comments"
                        }
                    ]
                }
            ]
        },
        "struct-declaration": {
            "patterns": [
                {
                    "name": "meta.struct.declaration.alum",
                    "begin": "\\b(struct)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(<[^>\\n]*>)?\\s*(\\{)",
                    "end": "(\\})",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.declaration.struct.alum"
                        },
                        "2": {
                            "name": "entity.name.type.struct.alum"
                        },
                        "3": {
                            "patterns": [
                                {
                                    "name": "punctuation.definition.generic.begin.alum",
                                    "match": "<"
                                },
                                {
                                    "name": "punctuation.definition.generic.end.alum",
                                    "match": ">"
                                },
                                {
                                    "name": "entity.name.type.parameter.alum",
                                    "match": "[A-Za-z_][A-Za-z0-9_]*"
                                }
                            ]
                        },
                        "4": {
                            "name": "punctuation.definition.block.begin.alum"
                        }
                    },
                    "endCaptures": {
                        "1": {
                            "name": "punctuation.definition.block.end.alum"
                        }
                    },
                    "patterns": [
                        {
                            "name": "meta.field.alum",
                            "match": "([A-Za-z_][A-Za-z0-9_]*)\\s*(:)",
                            "captures": {
                                "1": {
                                    "name": "variable.other.member.alum"
                                },
                                "2": {
                                    "name": "punctuation.separator.type-annotation.alum"
                                }
                            }
                        },
                        {
                            "include": "#types"
                        },
                        {
                            "name": "punctuation.separator.alum",
                            "match": ","
                        },
                        {
                            "include": "#comments"
                        }
                    ]
                }
            ]
        },
        "union-declaration": {
            "patterns": [
                {
                    "name": "meta.union.declaration.alum",
                    "begin": "\\b(union)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(<[^>\\n]*>)?\\s*(\\{)",
                    "end": "(\\})",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.declaration.union.alum"
                        },
                        "2": {
                            "name": "entity.name.type.union.alum"
                        },
                        "3": {
                            "patterns": [
                                {
                                    "name": "punctuation.definition.generic.begin.alum",
                                    "match": "<"
                                },
                                {
                                    "name": "punctuation.definition.generic.end.alum",
                                    "match": ">"
                                },
                                {
                                    "name": "entity.name.type.parameter.alum",
                                    "match": "[A-Za-z_][A-Za-z0-9_]*"
                                }
                            ]
                        },
                        "4": {
                            "name": "punctuation.definition.block.begin.alum"
                        }
                    },
                    "endCaptures": {
                        "1": {
                            "name": "punctuation.definition.block.end.alum"
                        }
                    },
                    "patterns": [
                        {
                            "name": "meta.field.alum",
                            "match": "([A-Za-z_][A-Za-z0-9_]*)\\s*(:)",
                            "captures": {
                                "1": {
                                    "name": "variable.other.member.alum"
                                },
                                "2": {
                                    "name": "punctuation.separator.type-annotation.alum"
                                }
                            }
                        },
                        {
                            "include": "#types"
                        },
                        {
                            "name": "punctuation.separator.alum",
                            "match": ","
                        },
                        {
                            "include": "#comments"
                        }
                    ]
                }
            ]
        },
        "enum-declaration": {
            "patterns": [
                {
                    "name": "meta.enum.declaration.alum",
                    "begin": "\\b(enum)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(\\{)",
                    "end": "(\\})",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.declaration.enum.alum"
                        },
                        "2": {
                            "name": "entity.name.type.enum.alum"
                        },
                        "3": {
                            "name": "punctuation.definition.block.begin.alum"
                        }
                    },
                    "endCaptures": {
                        "1": {
                            "name": "punctuation.definition.block.end.alum"
                        }
                    },
                    "patterns": [
                        {
                            "name": "meta.enum-member-assigned.alum",
                            "match": "([A-Za-z_][A-Za-z0-9_]*)\\s*(=)",
                            "captures": {
                                "1": {
                                    "name": "constant.other.enum.alum"
                                },
                                "2": {
                                    "name": "keyword.operator.assignment.alum"
                                }
                            }
                        },
                        {
                            "name": "constant.other.enum.alum",
                            "match": "[A-Za-z_][A-Za-z0-9_]*(?=\\s*(?:,|}|$))"
                        },
                        {
                            "include": "#literals"
                        },
                        {
                            "include": "#operators"
                        },
                        {
                            "include": "#comments"
                        }
                    ]
                }
            ]
        },
        "match-expression": {
            "patterns": [
                {
                    "name": "meta.match.alum",
                    "begin": "\\b(match)\\b\\s*([^\\n{]*)\\s*(\\{)",
                    "end": "(\\})",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.control.alum"
                        },
                        "2": {
                            "name": "variable.other.readwrite.alum"
                        },
                        "3": {
                            "name": "punctuation.definition.block.begin.alum"
                        }
                    },
                    "endCaptures": {
                        "1": {
                            "name": "punctuation.definition.block.end.alum"
                        }
                    },
                    "patterns": [
                        {
                            "name": "keyword.control.match.wildcard.alum",
                            "match": "\\b_\\s*(?=:)"
                        },
                        {
                            "name": "constant.other.enum.match-case.alum",
                            "match": "\\b[A-Z][A-Za-z0-9_]*\\s*(?=:)"
                        },
                        {
                            "name": "punctuation.separator.match-case.alum",
                            "match": ":"
                        },
                        {
                            "name": "meta.block.alum",
                            "begin": "(\\{)",
                            "end": "(\\})",
                            "beginCaptures": {
                                "1": {
                                    "name": "punctuation.definition.block.begin.alum"
                                }
                            },
                            "endCaptures": {
                                "1": {
                                    "name": "punctuation.definition.block.end.alum"
                                }
                            },
                            "patterns": [
                                {
                                    "include": "$self"
                                }
                            ]
                        },
                        {
                            "include": "$self"
                        }
                    ]
                }
            ]
        },
        "struct-literal": {
            "patterns": [
                {
                    "name": "meta.struct.literal.alum",
                    "begin": "\\b([A-Z][A-Za-z0-9_]*)(<[^>\\n]*>)?\\s*(\\{)",
                    "end": "(\\})",
                    "beginCaptures": {
                        "1": {
                            "name": "entity.name.type.struct.alum"
                        },
                        "2": {
                            "patterns": [
                                {
                                    "name": "punctuation.definition.generic.begin.alum",
                                    "match": "<"
                                },
                                {
                                    "name": "punctuation.definition.generic.end.alum",
                                    "match": ">"
                                },
                                {
                                    "name": "storage.type.alum",
                                    "match": "[A-Za-z_][A-Za-z0-9_]*"
                                }
                            ]
                        },
                        "3": {
                            "name": "punctuation.definition.block.begin.alum"
                        }
                    },
                    "endCaptures": {
                        "1": {
                            "name": "punctuation.definition.block.end.alum"
                        }
                    },
                    "patterns": [
                        {
                            "name": "meta.field.alum",
                            "match": "([A-Za-z_][A-Za-z0-9_]*)\\s*(:)",
                            "captures": {
                                "1": {
                                    "name": "variable.other.member.alum"
                                },
                                "2": {
                                    "name": "punctuation.separator.key-value.alum"
                                }
                            }
                        },
                        {
                            "include": "#comments"
                        },
                        {
                            "include": "$self"
                        }
                    ]
                }
            ]
        },
        "lambda": {
            "patterns": [
                {
                    "name": "meta.lambda.alum",
                    "begin": "(\\\\\\s*\\()",
                    "end": "(\\))\\s*(:)\\s*([A-Za-z_][A-Za-z0-9_]*(?:<[^>\\n]*>)?(?:\\[[0-9]*\\])?(?:\\s*\\([^)\\n]*\\))?)",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.declaration.lambda.alum"
                        }
                    },
                    "endCaptures": {
                        "1": {
                            "name": "punctuation.definition.parameters.end.alum"
                        },
                        "2": {
                            "name": "punctuation.separator.type-annotation.alum"
                        },
                        "3": {
                            "patterns": [
                                {
                                    "include": "#types"
                                }
                            ]
                        }
                    },
                    "patterns": [
                        {
                            "name": "meta.parameter.alum",
                            "match": "([A-Za-z_][A-Za-z0-9_]*)\\s*(:)",
                            "captures": {
                                "1": {
                                    "name": "variable.parameter.alum"
                                },
                                "2": {
                                    "name": "punctuation.separator.type-annotation.alum"
                                }
                            }
                        },
                        {
                            "include": "#types"
                        },
                        {
                            "name": "punctuation.definition.parameters.end.alum",
                            "match": "\\)"
                        },
                        {
                            "name": "punctuation.separator.alum",
                            "match": ","
                        },
                        {
                            "include": "$self"
                        }
                    ]
                }
            ]
        },
        "variable-declaration": {
            "patterns": [
                {
                    "name": "meta.variable.declaration.alum",
                    "match": "\\b(var)(\\s*\\(\\s*(pub)\\s*\\))?\\s+([A-Za-z_][A-Za-z0-9_]*)(\\s*(:)\\s*([A-Za-z_][A-Za-z0-9_]*(?:<[^>\\n]*>)?(?:\\[[0-9]*\\])?(?:\\s*\\([^)\\n]*\\))?))?\\s*(=)",
                    "captures": {
                        "1": {
                            "name": "storage.modifier.variable.alum"
                        },
                        "3": {
                            "name": "storage.modifier.pub.alum"
                        },
                        "4": {
                            "name": "variable.other.readwrite.alum"
                        },
                        "6": {
                            "patterns": [
                                {
                                    "name": "punctuation.separator.type-annotation.alum",
                                    "match": ":"
                                },
                                {
                                    "include": "#types"
                                }
                            ]
                        },
                        "9": {
                            "name": "keyword.operator.assignment.alum"
                        }
                    }
                }
            ]
        },
        "for-loop": {
            "patterns": [
                {
                    "name": "meta.for-loop.alum",
                    "match": "\\b(for)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s+(in)\\b",
                    "captures": {
                        "1": {
                            "name": "keyword.control.alum"
                        },
                        "2": {
                            "name": "variable.other.readwrite.alum"
                        },
                        "3": {
                            "name": "keyword.control.alum"
                        }
                    }
                }
            ]
        },
        "builtin-functions": {
            "patterns": [
                {
                    "name": "support.function.builtin.io.alum",
                    "match": "\\b(write|read|print|println|input|fopen|fclose|fread|fwrite|lseek)\\b"
                },
                {
                    "name": "support.function.builtin.vec.alum",
                    "match": "\\b(vec_new)\\b"
                },
                {
                    "name": "support.function.builtin.math.alum",
                    "match": "\\b(abs|sqrt|max|min|pow|fact)\\b"
                },
                {
                    "name": "support.function.builtin.string.alum",
                    "match": "\\b(strlen|strcpy|strcat|strcmp|memcpy|memset|bcmp|memcmp)\\b"
                },
                {
                    "name": "support.function.builtin.convert.alum",
                    "match": "\\b(itoa|atoi|atof|ftoa)\\b"
                },
                {
                    "name": "support.function.builtin.memory.alum",
                    "match": "\\b(malloc|free)\\b"
                },
                {
                    "name": "support.function.builtin.system.alum",
                    "match": "\\b(syscall|exit)\\b"
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
