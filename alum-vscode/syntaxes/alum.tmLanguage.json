{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Alum",
    "scopeName": "source.alum",
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#preprocessor"
        },
        {
            "include": "#typedef"
        },
        {
            "include": "#struct"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#types"
        },
        {
            "include": "#literals"
        },
        {
            "include": "#lambda"
        },
        {
            "include": "#function-pointer"
        },
        {
            "include": "#function-declarations"
        },
        {
            "include": "#extern-declarations"
        },
        {
            "include": "#function-calls"
        },
        {
            "include": "#operators"
        },
        {
            "include": "#builtin-functions"
        }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.alum",
                    "match": "//.*"
                }
            ]
        },
        "preprocessor": {
            "patterns": [
                {
                    "name": "keyword.control.preprocessor.alum",
                    "match": "\\b\\$(import|define|ifdef|ifndef|endif)\\b"
                },
                {
                    "name": "meta.preprocessor.import.alum",
                    "begin": "\\$import\\s+\"",
                    "end": "\"",
                    "beginCaptures": {
                        "0": {
                            "patterns": [
                                {
                                    "name": "keyword.control.preprocessor.alum",
                                    "match": "\\$import"
                                }
                            ]
                        }
                    },
                    "contentName": "string.quoted.double.alum"
                },
                {
                    "name": "meta.preprocessor.define.simple.alum",
                    "match": "(\\$define)\\s+(\\w+)\\s+([^\\n]+)",
                    "captures": {
                        "1": {
                            "name": "keyword.control.preprocessor.alum"
                        },
                        "2": {
                            "name": "entity.name.constant.alum"
                        },
                        "3": {
                            "name": "string.quoted.double.alum"
                        }
                    }
                },
                {
                    "name": "meta.preprocessor.define.macro.alum",
                    "match": "(\\$define)\\s+(\\w+)\\s*\\(",
                    "captures": {
                        "1": {
                            "name": "keyword.control.preprocessor.alum"
                        },
                        "2": {
                            "name": "entity.name.function.macro.alum"
                        }
                    }
                },
                {
                    "name": "meta.preprocessor.conditional.alum",
                    "match": "(\\$ifdef|\\$ifndef|\\$endif)\\b",
                    "captures": {
                        "1": {
                            "name": "keyword.control.preprocessor.conditional.alum"
                        }
                    }
                }
            ]
        },
        "typedef": {
            "patterns": [
                {
                    "name": "meta.typedef.alum",
                    "match": "(\\btypedef\\b)\\s+(\\w+)\\s*=\\s+([\\w\\[\\]]+)",
                    "captures": {
                        "1": {
                            "name": "keyword.declaration.typedef.alum"
                        },
                        "2": {
                            "name": "entity.name.type.typedef.alum"
                        },
                        "3": {
                            "patterns": [
                                {
                                    "include": "#types"
                                }
                            ]
                        }
                    }
                }
            ]
        },
        "struct": {
            "patterns": [
                {
                    "name": "meta.struct.declaration.alum",
                    "begin": "(\\bstruct\\b)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\{",
                    "end": "\\}",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.declaration.struct.alum"
                        },
                        "2": {
                            "name": "entity.name.type.struct.alum"
                        }
                    },
                    "patterns": [
                        {
                            "include": "#comments"
                        },
                        {
                            "name": "variable.other.member.alum",
                            "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*:",
                            "captures": {
                                "1": {
                                    "name": "variable.other.member.alum"
                                }
                            }
                        },
                        {
                            "include": "#types"
                        }
                    ]
                },
                {
                    "name": "meta.struct.literal.alum",
                    "begin": "([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\{",
                    "end": "\\}",
                    "beginCaptures": {
                        "1": {
                            "name": "entity.name.type.struct.alum"
                        }
                    },
                    "patterns": [
                        {
                            "name": "variable.other.member.alum",
                            "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*:",
                            "captures": {
                                "1": {
                                    "name": "variable.other.member.alum"
                                }
                            }
                        },
                        {
                            "include": "#literals"
                        },
                        {
                            "include": "#variables"
                        }
                    ]
                },
                {
                    "name": "variable.other.member.access.alum",
                    "match": "(?<=\\w)\\.([a-zA-Z_][a-zA-Z0-9_]*)",
                    "captures": {
                        "1": {
                            "name": "variable.other.member.alum"
                        }
                    }
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.alum",
                    "match": "\\b(let|return|if|else|while|for|in|break|continue)\\b"
                },
                {
                    "name": "keyword.declaration.function.alum",
                    "match": "\\bfun\\b"
                },
                {
                    "name": "keyword.declaration.extern.alum",
                    "match": "\\bextern\\b"
                },
                {
                    "name": "constant.language.boolean.alum",
                    "match": "\\b(true|false)\\b"
                },
                {
                    "name": "storage.type.primitive.alum",
                    "match": "\\b(void)\\b"
                }
            ]
        },
        "types": {
            "patterns": [
                {
                    "name": "storage.type.alum",
                    "match": "\\b(int|float|string|bool)\\b"
                },
                {
                    "name": "storage.type.array.alum",
                    "match": "\\barr\\b"
                },
                {
                    "name": "meta.type.array.generic.alum",
                    "match": "\\barr\\s*\\[\\s*([\\w]+)\\s*\\]",
                    "captures": {
                        "0": {
                            "patterns": [
                                {
                                    "name": "storage.type.array.alum",
                                    "match": "\\barr\\b"
                                },
                                {
                                    "name": "keyword.operator.angle-bracket.alum",
                                    "match": "\\[|\\]"
                                },
                                {
                                    "name": "storage.type.alum",
                                    "match": "\\w+"
                                }
                            ]
                        }
                    }
                },
                {
                    "name": "meta.type.function.pointer.alum",
                    "match": "([\\w\\[\\]]+)\\s*\\(",
                    "captures": {
                        "1": {
                            "patterns": [
                                {
                                    "include": "#types"
                                }
                            ]
                        }
                    }
                }
            ]
        },
        "literals": {
            "patterns": [
                {
                    "name": "constant.numeric.integer.alum",
                    "match": "\\b\\d+\\b"
                },
                {
                    "name": "constant.numeric.float.alum",
                    "match": "\\b\\d+\\.\\d+\\b"
                },
                {
                    "name": "string.quoted.double.alum",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.alum",
                            "match": "\\\\."
                        }
                    ]
                },
                {
                    "name": "meta.array.literal.alum",
                    "begin": "\\[",
                    "end": "\\]",
                    "beginCaptures": {
                        "0": {
                            "name": "keyword.operator.bracket.alum"
                        }
                    },
                    "endCaptures": {
                        "0": {
                            "name": "keyword.operator.bracket.alum"
                        }
                    },
                    "patterns": [
                        {
                            "include": "$self"
                        }
                    ]
                },
                {
                    "name": "meta.array.fill.alum",
                    "match": "\\[\\s*([\\w]+)\\s*;\\s*(\\d+)\\s*\\]",
                    "captures": {
                        "0": {
                            "patterns": [
                                {
                                    "name": "keyword.operator.bracket.alum",
                                    "match": "\\[|\\]"
                                }
                            ]
                        },
                        "1": {
                            "name": "storage.type.alum"
                        },
                        "2": {
                            "name": "constant.numeric.integer.alum"
                        }
                    }
                }
            ]
        },
        "lambda": {
            "patterns": [
                {
                    "name": "meta.lambda.alum",
                    "begin": "\\blamb\\b",
                    "end": "(?=\\})",
                    "beginCaptures": {
                        "0": {
                            "name": "keyword.declaration.lambda.alum"
                        }
                    },
                    "patterns": [
                        {
                            "name": "punctuation.definition.parameters.begin.alum",
                            "match": "\\("
                        },
                        {
                            "name": "punctuation.definition.parameters.end.alum",
                            "match": "\\)"
                        },
                        {
                            "name": "variable.parameter.alum",
                            "match": "[a-zA-Z_][a-zA-Z0-9_]*"
                        },
                        {
                            "include": "#types"
                        },
                        {
                            "name": "punctuation.separator.alum",
                            "match": ","
                        },
                        {
                            "name": "punctuation.separator.alum",
                            "match": ":"
                        },
                        {
                            "include": "$self"
                        }
                    ]
                }
            ]
        },
        "function-pointer": {
            "patterns": [
                {
                    "name": "meta.function.pointer.type.alum",
                    "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*:\\s*([\\w\\[\\]]+)\\s*\\(",
                    "captures": {
                        "1": {
                            "name": "variable.other.constant.alum"
                        },
                        "2": {
                            "patterns": [
                                {
                                    "include": "#types"
                                }
                            ]
                        }
                    }
                }
            ]
        },
        "function-declarations": {
            "patterns": [
                {
                    "name": "meta.function.declaration.alum",
                    "begin": "\\b(fun)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
                    "end": "\\)(\\s*:\\s*[\\w\\[\\]]+)?\\s*(?==|\\{)",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.declaration.function.alum"
                        },
                        "2": {
                            "name": "entity.name.function.alum"
                        }
                    },
                    "endCaptures": {
                        "1": {
                            "patterns": [
                                {
                                    "include": "#types"
                                }
                            ]
                        }
                    },
                    "patterns": [
                        {
                            "include": "#types"
                        },
                        {
                            "name": "variable.parameter.alum",
                            "match": "[a-zA-Z_][a-zA-Z0-9_]*"
                        },
                        {
                            "name": "keyword.operator.alum",
                            "match": "[:,()]"
                        }
                    ]
                }
            ]
        },
        "extern-declarations": {
            "patterns": [
                {
                    "name": "meta.extern.declaration.alum",
                    "begin": "\\b(extern)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
                    "end": "\\)(\\s*:\\s*[\\w\\[\\]]+)?\\s*(?=;)",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.declaration.extern.alum"
                        },
                        "2": {
                            "name": "entity.name.function.extern.alum"
                        }
                    },
                    "endCaptures": {
                        "1": {
                            "patterns": [
                                {
                                    "include": "#types"
                                }
                            ]
                        }
                    },
                    "patterns": [
                        {
                            "include": "#types"
                        },
                        {
                            "name": "variable.parameter.alum",
                            "match": "[a-zA-Z_][a-zA-Z0-9_]*"
                        },
                        {
                            "name": "keyword.operator.alum",
                            "match": "[:,()]"
                        }
                    ]
                }
            ]
        },
        "function-calls": {
            "patterns": [
                {
                    "name": "meta.function.call.alum",
                    "begin": "([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
                    "end": "\\)",
                    "beginCaptures": {
                        "1": {
                            "name": "entity.name.function.alum"
                        }
                    },
                    "patterns": [
                        {
                            "include": "$self"
                        }
                    ]
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.arithmetic.alum",
                    "match": "\\+|\\-|\\*|\\/"
                },
                {
                    "name": "keyword.operator.assignment.alum",
                    "match": "=|\\+=|\\-=|\\*=|\\/="
                },
                {
                    "name": "keyword.operator.comparison.alum",
                    "match": "==|!=|>|<|>=|<="
                },
                {
                    "name": "keyword.operator.logical.alum",
                    "match": "&&|\\|\\|!"
                },
                {
                    "name": "keyword.operator.access.alum",
                    "match": "\\."
                },
                {
                    "name": "keyword.operator.range.alum",
                    "match": "\\.\\."
                },
                {
                    "name": "keyword.operator.bracket.alum",
                    "match": "\\[|\\]"
                },
                {
                    "name": "keyword.operator.parenthesis.alum",
                    "match": "\\(|\\)"
                },
                {
                    "name": "keyword.operator.brace.alum",
                    "match": "\\{|\\}"
                }
            ]
        },
        "builtin-functions": {
            "patterns": [
                {
                    "name": "support.function.builtin.io.alum",
                    "match": "\\b(print|println|input|read|write|fopen|fclose|fread|fwrite|lseek)\\b"
                },
                {
                    "name": "support.function.builtin.math.alum",
                    "match": "\\b(abs|sqrt|max|min|pow|fact)\\b"
                },
                {
                    "name": "support.function.builtin.string.alum",
                    "match": "\\b(strlen|strcpy|strcat|memcpy|memset|bcmp|memcmp)\\b"
                },
                {
                    "name": "support.function.builtin.convert.alum",
                    "match": "\\b(itoa|atoi|atof|ftoa)\\b"
                },
                {
                    "name": "support.function.builtin.memory.alum",
                    "match": "\\b(malloc)\\b"
                },
                {
                    "name": "support.function.builtin.system.alum",
                    "match": "\\b(syscall|exit)\\b"
                }
            ]
        },
        "variables": {
            "patterns": [
                {
                    "name": "variable.other.readwrite.alum",
                    "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
                }
            ]
        }
    }
}