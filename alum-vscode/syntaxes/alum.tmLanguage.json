{
    "name": "Alum",
    "scopeName": "source.alum",
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#preprocessor"
        },
        {
            "include": "#copy-op"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#fstrings"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#constants"
        },
        {
            "include": "#primitive-types"
        },
        {
            "include": "#control-keywords"
        },
        {
            "include": "#declaration-keywords"
        },
        {
            "include": "#function-call"
        },
        {
            "include": "#property-access"
        },
        {
            "include": "#operators"
        },
        {
            "include": "#punctuation"
        }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.alum",
                    "match": "//.*$"
                }
            ]
        },
        "preprocessor": {
            "patterns": [
                {
                    "name": "meta.preprocessor.alum",
                    "match": "(\\$)(import|define|ifdef|ifndef|else|endif)\\b",
                    "captures": {
                        "1": {
                            "name": "punctuation.definition.preprocessor.alum"
                        },
                        "2": {
                            "name": "keyword.control.import.alum"
                        }
                    }
                }
            ],
            "match": "(\\#)(include|define|ifdef|ifndef|else|endif)\\b"
        },
        "strings": {
            "name": "string.quoted.double.alum",
            "begin": "\"",
            "end": "\"",
            "patterns": [
                {
                    "name": "constant.character.escape.alum",
                    "match": "\\\\."
                }
            ]
        },
        "fstrings": {
            "name": "string.quoted.double.interpolated.alum",
            "begin": "f\"",
            "end": "\"",
            "patterns": [
                {
                    "name": "constant.character.escape.alum",
                    "match": "\\\\."
                },
                {
                    "name": "meta.interpolation.alum",
                    "begin": "\\{",
                    "end": "\\}",
                    "patterns": [
                        {
                            "include": "#numbers"
                        },
                        {
                            "name": "variable.other.alum",
                            "match": "\\b[A-Za-z_]\\w*\\b"
                        }
                    ]
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.float.alum",
                    "match": "\\b\\d+\\.\\d+\\b"
                },
                {
                    "name": "constant.numeric.integer.alum",
                    "match": "\\b\\d+\\b"
                }
            ]
        },
        "constants": {
            "name": "constant.language.alum",
            "match": "\\b(true|false|nil)\\b"
        },
        "primitive-types": {
            "name": "storage.type.alum",
            "match": "\\b(int|float|bool|string|void)\\b"
        },
        "control-keywords": {
            "name": "keyword.control.alum",
            "match": "\\b(if|else|while|for|in|match|return|break|continue)\\b"
        },
        "declaration-keywords": {
            "patterns": [
                {
                    "name": "keyword.declaration.alum",
                    "match": "\\b(fun|var|cst|struct|union|enum|typedef|extern|import|using|as)\\b"
                },
                {
                    "name": "storage.modifier.alum",
                    "match": "\\b(pub|pure)\\b"
                }
            ]
        },
        "function-call": {
            "name": "entity.name.function.alum",
            "match": "\\b[A-Za-z_]\\w*\\s*(?=\\()"
        },
        "property-access": {
            "name": "variable.other.property.alum",
            "match": "(?<=\\.)[A-Za-z_]\\w*"
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.assignment.alum",
                    "match": "<<=|>>=|[+\\-*/%&|^]="
                },
                {
                    "name": "keyword.operator.comparison.alum",
                    "match": "==|!=|<=|>=|[<>]"
                },
                {
                    "name": "keyword.operator.logical.alum",
                    "match": "&&|\\|\\||!"
                },
                {
                    "name": "keyword.operator.arithmetic.alum",
                    "match": "\\+\\+|--|<<|>>|[+\\-*/%&|^~]"
                },
                {
                    "name": "keyword.operator.alum",
                    "match": "[@;,.?=]"
                }
            ]
        },
        "punctuation": {
            "patterns": [
                {
                    "name": "punctuation.section.braces.begin.alum",
                    "match": "\\{"
                },
                {
                    "name": "punctuation.section.braces.end.alum",
                    "match": "\\}"
                },
                {
                    "name": "punctuation.separator.parenthesis.alum",
                    "match": "[()]"
                },
                {
                    "name": "punctuation.separator.square-brackets.alum",
                    "match": "\\[|\\]"
                }
            ]
        },
        "copy-op": {
            "name": "keyword.operator.copy.alum",
            "match": "\\$[A-Za-z_]\\w*"
        }
    }
}