{"comments": {"lineComment": "//"}, "brackets": [["{", "}"], ["[", "]"], ["(", ")"]], "autoClosingPairs": [{"open": "{", "close": "}"}, {"open": "[", "close": "]"}, {"open": "(", "close": ")"}, {"open": "\"", "close": "\"", "notIn": ["string"]}], "surroundingPairs": [["{", "}"], ["[", "]"], ["(", ")"], ["\"", "\""]], "folding": {"markers": {"start": "^\\s*//\\s*region\\b", "end": "^\\s*//\\s*endregion\\b"}}, "wordPattern": "(-?\\d*\\.\\d\\w*)|([^\\`\\~\\!\\@\\#\\%\\^\\&\\*\\(\\)\\-\\=\\+\\[\\]\\{\\}\\|\\;\\:'\\\"\\,\\.\\<\\>\\/\\?\\s]+)", "indentationRules": {"increaseIndentPattern": "^.*\\{[^}\"']*$|^.*\\([^)\"']*$", "decreaseIndentPattern": "^\\s*\\}|^\\s*\\)"}, "onEnterRules": [{"beforeText": "^\\s*(fun|struct|extern)\\s+.*\\{$", "action": {"indent": "indent"}}, {"beforeText": "^\\s*if\\s*\\([^)]*\\)\\s*\\{$", "action": {"indent": "indent"}}, {"beforeText": "^\\s*(else|while|for)\\s*\\{?\\s*$", "action": {"indent": "indent"}}]}