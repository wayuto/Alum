{
    "name": "alum-vscode",
    "displayName": "alum-vscode",
    "description": "Alum Programming Language - Syntax highlighting and language support for VSCode",
    "version": "0.9.8",
    "engines": {
        "vscode": "^1.107.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "main": "./extension.js",
    "contributes": {
        "languages": [
            {
                "id": "alum",
                "aliases": [
                    "alum",
                    "Alum"
                ],
                "extensions": [
                    "al",
                    "ah"
                ],
                "configuration": "./language-configuration.json",
                "icon": {
                    "dark": "./icons/alum-file-dark.svg",
                    "light": "./icons/alum-file-light.svg"
                }
            }
        ],
        "grammars": [
            {
                "language": "alum",
                "scopeName": "source.alum",
                "path": "./syntaxes/alum.tmLanguage.json"
            }
        ],
        "configuration": {
            "title": "Alum",
            "properties": {
                "alum.lsp.path": {
                    "type": "string",
                    "default": "alum-lsp",
                    "description": "Path to the alum-lsp executable (default: lookup 'alum-lsp' on PATH)"
                }
            }
        },
        "commands": [
            {
                "command": "alum.restartLsp",
                "title": "Alum: Restart Language Server"
            }
        ]
    },
    "scripts": {
        "test": "echo \"Error: no test specified\" && exit 1"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "vscode-languageclient": "^9.0.1"
    },
    "devDependencies": {
        "@vscode/vsce": "^3.9.2"
    }
}