$ifndef ALUM_STRING
$define ALUM_STRING 1

fun(pure) strlen(s: string): int {
    var p: *void = s
    var i: int = 0
    while true {
        var b: int = p[i]
        if b == 0 break
        i = i + 1
    }
    return i
}

fun(extern) strcpy(dst: string, src: string): string
fun(extern) strcat(dst: string, src: string): string

fun(pure) strcmp(s1: string, s2: string): int {
    var p1: *void = s1
    var p2: *void = s2
    var i: int = 0
    while true {
        var a: int = p1[i]
        var b: int = p2[i]
        if a != b {
            return a - b
        }
        if a == 0 {
            return 0
        }
        i = i + 1
    }
    return 0
}

fun(extern) memcpy(dst: string, src: string, n: int): string
fun(extern) memset(s: string, c: int, n: int): string

fun(pure) bcmp(s1: string, s2: string, n: int): int {
    var p1: *void = s1
    var p2: *void = s2
    var i: int = 0
    while i < n {
        var a: int = p1[i]
        var b: int = p2[i]
        if a != b {
            return a - b
        }
        i = i + 1
    }
    return 0
}

fun(pure) memcmp(s1: string, s2: string, n: int): int {
    return bcmp(s1, s2, n)
}

$endif