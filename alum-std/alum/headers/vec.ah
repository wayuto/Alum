$ifndef ALUM_VEC
$define ALUM_VEC 1

struct Vec<T> {
    data: T[],
    len: int,
    capacity: int,
    at: T(*Vec<T>, int),
    push: void(*Vec<T>, T),
    pop: T(*Vec<T>),
    clear: void(*Vec<T>),
}

fun vec_new<T>(): Vec<T> {
    return Vec<T> {
        data: [T; 0],
        len: 0,
        capacity: 0,
		at: \(v: *Vec<T>, i: int): T {
			if i >= v.len || i < 0 return nil
			return v.data[i]
		},
		push: \(v: *Vec<T>, elem: T): void {
			if v.len >= v.capacity {
				let new_capacity: int = if v.capacity == 0 {
					4
				} else {
					v.capacity * 2
				}
				let new_data: T[] = [T; new_capacity]
				for i in 0..v.len {
					new_data[i] = v.data[i]
				}
				v.data = new_data
				v.capacity = new_capacity
			}
			v.data[v.len] = elem
			v.len = v.len + 1
		},
		pop: \(v: *Vec<T>): T {
			if v.len == 0 return nil
			v.len = v.len - 1
			let elem: T = v.data[v.len]
			return elem
		},
		clear: \(v: *Vec<T>): void {
			v.len = 0
			v.capacity = 0
			v.data = [T; 0]
		},
	}
}

$endif
