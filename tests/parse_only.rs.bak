#[path = "/home/w/Projects/Alum/src/compiler/mod.rs"]
mod compiler;
use compiler::lexer::Lexer;
use compiler::parser::Parser;
fn main() {
    let lexer = Lexer::new("var x: int = 0\n++i");
    let mut parser = Parser::new(lexer);
    match parser.parse() {
        Ok(p) => println!("{}", p),
        Err(e) => println!("ERR: {}", e),
    }
}
